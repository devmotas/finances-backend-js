# Local: sempre o branch "dev" do Neon (cópia da produção), nunca o "production".
# A produção usa só as variáveis configuradas na Vercel.
#   npx neonctl connection-string dev --database-name neondb --role-name neondb_owner
DATABASE_URL="postgresql://user:password@host-do-branch-dev/neondb?sslmode=require"

# Chave secreta para geração dos JWTs (mínimo 32 caracteres)
JWT_SECRET="gere-uma-chave-forte-aqui-com-32-bytes-ou-mais"

# Expiração do token em milissegundos (86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# Origens permitidas pelo CORS (separadas por vírgula)
# Ex: https://finances-frontend-gray.vercel.app,http://localhost:4200
CORS_ALLOWED_ORIGINS="http://localhost:4200"
