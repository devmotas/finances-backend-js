# URL de conexão PostgreSQL (formato Prisma)
# Para banco existente no Render:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?connection_limit=1"
# Para banco novo (Vercel Postgres / Neon):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/finances"

# Chave secreta para geração dos JWTs (mínimo 32 caracteres)
JWT_SECRET="gere-uma-chave-forte-aqui-com-32-bytes-ou-mais"

# Expiração do token em milissegundos (86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# Origens permitidas pelo CORS (separadas por vírgula)
# Ex: https://finances-frontend-gray.vercel.app,http://localhost:4200
CORS_ALLOWED_ORIGINS="http://localhost:4200"
